# Turso (libSQL). The URL is not secret; the token is — never commit it.
TURSO_DATABASE_URL=libsql://teton-cpq-kmwinn21-beep.aws-us-west-2.turso.io
TURSO_AUTH_TOKEN=

# For local development without Turso, point at a file instead (no token needed):
# TURSO_DATABASE_URL=file:local.db

# Session signing key, at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
